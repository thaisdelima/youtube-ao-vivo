{
  "name": "Miopia",
  "type": "dark",
  "colors": {
    "editor.background": "#1e2127",
    "editor.foreground": "#e6e3d8",
    "editorCursor.foreground": "#ffd75f",
    "editor.selectionBackground": "#3d5a80",
    "editor.lineHighlightBackground": "#262a32",
    "editor.findMatchBackground": "#7a5c00",
    "editor.findMatchHighlightBackground": "#5c4a1a",
    "editorLineNumber.foreground": "#8b93a1",
    "editorLineNumber.activeForeground": "#ffd75f",
    "editorWhitespace.foreground": "#444a56",
    "editorIndentGuide.background1": "#3a3f4a",
    "sideBar.background": "#1a1d22",
    "sideBar.foreground": "#e6e3d8",
    "activityBar.background": "#16181d",
    "activityBar.foreground": "#ffffff",
    "statusBar.background": "#2b3a55",
    "statusBar.foreground": "#ffffff",
    "titleBar.activeBackground": "#16181d",
    "titleBar.activeForeground": "#e6e3d8",
    "tab.activeBackground": "#1e2127",
    "tab.inactiveBackground": "#16181d",
    "tab.inactiveForeground": "#a9b0bd",
    "panel.background": "#1e2127",
    "focusBorder": "#ffd75f",
    "terminal.background": "#1e2127",
    "terminal.foreground": "#e6e3d8",
    "terminal.ansiBlack": "#2b2f38",
    "terminal.ansiRed": "#ff8a80",
    "terminal.ansiGreen": "#8fe388",
    "terminal.ansiYellow": "#ffd75f",
    "terminal.ansiBlue": "#8ab4ff",
    "terminal.ansiMagenta": "#e5a0ff",
    "terminal.ansiCyan": "#7fe0e0",
    "terminal.ansiWhite": "#e6e3d8",
    "terminal.ansiBrightBlack": "#8b93a1",
    "terminal.ansiBrightRed": "#ffaaa3",
    "terminal.ansiBrightGreen": "#adf5a6",
    "terminal.ansiBrightYellow": "#ffe58f",
    "terminal.ansiBrightBlue": "#acc8ff",
    "terminal.ansiBrightMagenta": "#eebfff",
    "terminal.ansiBrightCyan": "#a3f0f0",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#9aa3b2", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "#8fe388" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#ffd75f" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#e5a0ff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8ab4ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": { "foreground": "#7fe0e0" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#e6e3d8" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff8a80" } }
  ]
}
